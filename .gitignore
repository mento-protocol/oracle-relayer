# Terraform Stuff
.terraform/
.terraform*
terraform.tfstate*
errored.tfstate
*.tfvars

# Cloud Function Stuff
# Every .env variant (.env~, .env.bak, .env.local, .env.yaml, .env.backup-*, ...)
# except the tracked example. .env may hold private keys.
.env*
!.env.example
dist/
function-source.zip
node_modules/

# JS/TS Stuff
# We use npm for dependency management
pnpm-lock.yaml

# Local Stuff
.project_vars_cache

# Editor backups and swap files (a stray .env~ or ..env.swp must never be staged)
*~
*.swp
*.swo

# Ignore .claude except shared project settings (SessionStart hook for worktree setup)
.claude/*
!.claude/settings.json
.reviews/
